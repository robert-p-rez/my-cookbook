# Create a dedicated Cloudflare Tunnel for this site and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Your Zero Trust team domain. Either form is accepted:
#   your-team.cloudflareaccess.com
#   https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag from the Cloudflare Access app.
CLOUDFLARE_ACCESS_AUD=

# Optional defense-in-depth allowlist. Leave blank to rely on the Access policy.
# Comma-separated example: gabby@example.com,admin@example.com
ACCESS_ALLOWED_EMAILS=
